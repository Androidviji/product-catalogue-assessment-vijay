# Example configuration. Copy to .env if you want to change anything; the defaults work as-is.
# No secrets are needed for local development. Never commit a real .env file.
#
# Note: Docker Compose reads .env automatically. The Spring Boot backend does not;
# when running it with mvnw, set these as environment variables instead (see backend/README.md).

# --- Backend ---
# Product IDs chosen by the business owner for the home page, in display order.
FEATURED_PRODUCT_IDS=1,5,9,17,20
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_CONNECT_TIMEOUT=3s
FAKE_STORE_READ_TIMEOUT=5s
SERVER_PORT=8080

# --- Enquiry email ---
# Defaults send to the local Mailpit test inbox, which never delivers to a real mailbox.
ENQUIRY_SALES_INBOX=sales@officeworks.test
ENQUIRY_FROM_ADDRESS=catalogue-app@officeworks.test
SMTP_HOST=localhost
SMTP_PORT=1025
# Only for a real SMTP provider. Set these as environment variables; never commit real values.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Mailpit (docker-compose.yml) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
